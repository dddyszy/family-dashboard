# 复制为 .env 后修改。docker compose 会自动读取同目录下的 .env

# 必填：至少 32 位的随机字符串。可执行 openssl rand -hex 32 生成
APP_SECRET=

# 对外访问的 HTTPS 地址（配置好反向代理后填写），例如 https://dash.example.com
PUBLIC_URL=

# 可选：镜像地址。默认拉取 GitHub 上的镜像；国内拉取慢时改为阿里云镜像，例如
# IMAGE=registry.cn-hangzhou.aliyuncs.com/你的命名空间/family-dashboard:latest
# 也可以固定到某个版本，例如 ghcr.io/dddyszy/family-dashboard:0.1.0

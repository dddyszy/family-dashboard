{
  "name": "family-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@family/server' --filter '@family/web' dev",
    "check": "biome check . && bun run typecheck && bun test",
    "fix": "biome check --write .",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "build": "bun --filter '@family/web' build",
    "preview": "bun run build && bun --filter '@family/server' preview",
    "start": "bun --filter '@family/server' start",
    "db:generate": "bun --filter '@family/server' db:generate",
    "db:migrate": "bun --filter '@family/server' db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
